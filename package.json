{
  "name": "wetext-wasm",
  "version": "0.2.0",
  "description": "WeTextProcessing normalization for JavaScript with an OpenFst WebAssembly runtime",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models/*": "./models/*",
    "./wetext.wasm": "./dist/wetext.wasm"
  },
  "files": [
    "dist",
    "models",
    "README.md",
    "LICENSE",
    "licenses",
    "sources.json",
    "THIRD_PARTY_NOTICES.md",
    "scripts/setup.mjs",
    "scripts/python.mjs",
    "scripts/export_models.py",
    "scripts/zh_dictation.py"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "models": "node scripts/python.mjs scripts/export_models.py",
    "test:fixtures": "node scripts/python.mjs scripts/export_core.py",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:upstream": "node scripts/python.mjs -m pytest vendor/WeTextProcessing -q",
    "test:reference": "node scripts/verify.mjs reference",
    "test:parity": "node scripts/verify.mjs parity",
    "check": "npm run typecheck && npm test && npm run test:parity"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1orZero/wetext-wasm.git"
  }
}
